{
  "name": "melee-combos",
  "description": "Finds the clip-worthy punishes in your Slippi replays and learns your taste from your ratings",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "build": "node build.js"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@slippi/slippi-js": "^6.7.0"
  },
  "devDependencies": {
    "@semantic-release/exec": "^7.1.0",
    "bun": "^1.2.19",
    "semantic-release": "^25.0.9"
  },
  "private": true,
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "node build.js ${nextRelease.version}"
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": [
            "dist/*"
          ],
          "successComment": false,
          "failComment": false,
          "releasedLabels": false
        }
      ]
    ]
  }
}
